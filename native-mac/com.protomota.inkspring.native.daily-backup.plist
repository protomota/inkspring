<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.protomota.inkspring.native.daily-backup</string>
    <key>BundleProgram</key><string>Contents/MacOS/Inkspring</string>
    <key>ProgramArguments</key>
    <array>
        <string>Inkspring</string>
        <string>--daily-backup</string>
    </array>
    <key>AssociatedBundleIdentifiers</key>
    <array><string>com.protomota.inkspring.native</string></array>
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>3</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
